# Copy to .env and fill in your key(s).
# Only one key is needed — pick your provider and update MODEL in each script.

# Gemini (default provider used in the pipeline)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatives — change MODEL = "..." in each script to switch
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here
