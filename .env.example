# Copy to .env and fill in your key(s).
# Set LLM_PROVIDER to select a backend. MODEL overrides the default model for that
# provider — omit it to use the built-in default.

LLM_PROVIDER=mlx
MODEL=openai/unsloth/Qwen3.6-35B-A3B-UD-MLX-4bit

# Uncomment if using any of paid API providers.
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here